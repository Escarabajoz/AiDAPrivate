# ==========================================
# 1. BASE RULES (These MUST come first)
# ==========================================
# Block everything by default
/*

# Allow the specific root directories you want
!/src/
!/tools/
!/cmake/
!/docs/
!/camoufox-reverse-mcp/
!/sources/
!/libdecomp/

# Allow essential project configuration files
!.gitignore
!.aider*
!CMakeLists.txt
!CLAUDE.md
!AGENTS.md
!build-host.ps1
!build-host.cmd
!CMakePresets.json

# ==========================================
# 2. EXCLUSIONS (These override the allows)
# ==========================================

# Images and Media
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.wav

# Compiled Libs and Binaries
*.lib
*.dll
*.exe
*.pdb
*.obj
*.sys
*.ilk
*.user
*.suo
*.sdf
*.opensdf
*.vcxproj.user

# Dependencies & Build Artifacts
**/node_modules/
**/packages/
**/artifacts/
**/obj/
**/bin/
**/build/
/.cache/
/dist/
__pycache__/
*.py[cod]
.venv/
vcpkg_installed/
compile_commands.json

# IDEs & Environments
.vs/
.idea/

# Secrets
.env
*.pem
*.p12

# Aider and local cache
models.json

# Massive Third-Party Headers/Directories
**/freetype/
**/stb_image.h

# Asset Byte Arrays (Using ** to catch them anywhere)
**/assets/
**/theme_icons/
**/aidalogo.c
**/background.c

# Allow required Qt resource images (blocked by *.png above, but needed for qrc)
!/src/standalone/resources/img/aidalogo.png
!/src/standalone/resources/img/background.webp

# Excluded Project Roots
/bot/
/firebase/
/ida-sdk/
/libs/
/mapper/
/packaging/
/sources/*
!/sources/ghidra/
!/sources/Triton/

# Excluded specific files
/perception_analysis.md
/vganalysis.md
/win10afd.md
/win11_24h2_afd.md
/win11_25h2_afd.md
.aider*
