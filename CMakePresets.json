{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC + sccache (RELEASE)",
      "description": "Canonical production build. Ninja drives the build graph (single-graph parallelism beats per-vcxproj /m), sccache caches every .obj keyed on preprocessed input (second clean rebuild is mostly cache hits), /Z7 embeds debug info via CMP0141 (no mspdbsrv.exe serialization). This is the only supported build configuration. Run from a 'x64 Native Tools Command Prompt for VS 2022' so cl.exe is on PATH, or use the VS Code task which calls vcvars64.bat first.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "AIDA_ENABLE_LTCG": "OFF",
        "AIDA_FAST_LINK":   "ON",
        "AIDA_CAMOUFOX_STAGE_REVERSE_MCP_SOURCE": "ON",
        "AIDA_CAMOUFOX_STAGE_SIDECAR_DEPS": "ON",
        "BUILD_AIDA_PLUGIN": "OFF"
      },
      "environment": {
        "SCCACHE_DIR":             "${sourceDir}/.sccache",
        "SCCACHE_CACHE_SIZE":      "20G",
        "SCCACHE_IDLE_TIMEOUT":    "0",
        "SCCACHE_RECACHE":         "0",
        "SCCACHE_DISABLE":         "0"
      }
    },
    {
      "name": "ninja-msvc-fast",
      "displayName": "Ninja + MSVC FAST (no harden + unity)",
      "description": "Fast dev build: same Ninja graph but AIDA_HARDEN_RELEASE=OFF (no /guard:cf/xfg/Qspectre/sdl), UNITY batch 16 (fewer TUs), /O2 + /cgthreads8. 25-35% faster clean, identical output ABI. Use for iterate.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "AIDA_ENABLE_LTCG": "OFF",
        "AIDA_FAST_LINK":   "ON",
        "AIDA_HARDEN_RELEASE": "OFF",
        "AIDA_UNITY_BUILD": "OFF",
        "AIDA_CAMOUFOX_STAGE_REVERSE_MCP_SOURCE": "OFF",
        "AIDA_CAMOUFOX_STAGE_SIDECAR_DEPS": "OFF",
        "BUILD_AIDA_PLUGIN": "OFF"
      },
      "environment": {
        "SCCACHE_DIR":             "${sourceDir}/.sccache",
        "SCCACHE_CACHE_SIZE":      "20G",
        "SCCACHE_IDLE_TIMEOUT":    "0",
        "SCCACHE_RECACHE":         "0",
        "SCCACHE_DISABLE":         "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc-release",
      "configurePreset": "ninja-msvc-release",
      "jobs": 16
    },
    {
      "name": "ninja-msvc-rebuild",
      "configurePreset": "ninja-msvc-release",
      "cleanFirst": true,
      "jobs": 16
    },
    {
      "name": "ninja-msvc-fast",
      "configurePreset": "ninja-msvc-fast",
      "jobs": 16
    },
    {
      "name": "ninja-msvc-fast-rebuild",
      "configurePreset": "ninja-msvc-fast",
      "cleanFirst": true,
      "jobs": 16
    }
  ]
}
